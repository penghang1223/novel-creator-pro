# cc-connect 配置文件
# 文档：https://github.com/chenhg5/cc-connect/blob/main/docs/usage.md
#
# 使用方式：
#   1. 复制本文件为 cc-connect-config.toml
#   2. 从飞书开发者后台获取 app_id 和 app_secret 填入
#   3. 或使用环境变量：FEISHU_APP_ID、FEISHU_APP_SECRET

[log]
level = "info"

[[projects]]
name = "novel-creator"

[projects.agent]
type = "claudecode"

[projects.agent.options]
work_dir = "/Users/narain/Desktop/novel/NOVEL_CREAT"
mode = "auto"

[[projects.platforms]]
type = "feishu"

[projects.platforms.options]
app_id = "${FEISHU_APP_ID}"
app_secret = "${FEISHU_APP_SECRET}"
