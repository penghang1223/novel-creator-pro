{
  "version": "1.0",
  "description": "小说创作记忆系统数据结构定义",
  "layers": {
    "style_dna": {
      "description": "第一层：风格DNA层 - 存储作者独特的写作风格特征",
      "file": "style_dna.json",
      "structure": {
        "memory_type": "style_dna",
        "memories": [
          {
            "memory_id": "style_dna_YYYYMMDDHHMMSS",
            "created_at": "ISO 8601 datetime",
            "updated_at": "ISO 8601 datetime",
            "data": {
              "metadata": {
                "author": "string",
                "extract_date": "ISO 8601 datetime",
                "sample_chapters": "integer",
                "total_words": "integer",
                "total_sentences": "integer"
              },
              "sentence_features": {
                "length_distribution": {
                  "short": "number (0-1)",
                  "medium": "number (0-1)",
                  "long": "number (0-1)",
                  "avg_length": "number",
                  "std_length": "number"
                },
                "type_ratio": {
                  "declarative": "number (0-1)",
                  "interrogative": "number (0-1)",
                  "exclamatory": "number (0-1)"
                },
                "complexity_index": "number (0-1)"
              },
              "word_usage": {
                "high_freq_words": [
                  {
                    "word": "string",
                    "freq": "integer",
                    "ratio": "number"
                  }
                ],
                "pos_distribution": {
                  "pos_tag": "number (0-1)"
                },
                "unique_words": ["string"],
                "avg_word_length": "number"
              },
              "description_style": {
                "environment_ratio": "number (0-1)",
                "psychology_ratio": "number (0-1)",
                "action_ratio": "number (0-1)",
                "typical_patterns": [
                  {
                    "type": "string (environment|psychology|action)",
                    "pattern": "string"
                  }
                ]
              },
              "dialogue_style": {
                "dialogue_ratio": "number (0-1)",
                "marker_preference": [
                  {
                    "marker": "string",
                    "freq": "integer",
                    "ratio": "number"
                  }
                ],
                "rhythm_features": {
                  "avg_length": "number",
                  "short_ratio": "number (0-1)",
                  "medium_ratio": "number (0-1)",
                  "long_ratio": "number (0-1)"
                },
                "typical_patterns": ["string"]
              }
            },
            "metadata": {
              "source_files": ["string"],
              "notes": "string"
            }
          }
        ]
      }
    },
    "character": {
      "description": "第二层：人物一致性层 - 维护所有主要人物的档案",
      "file": "characters.json",
      "structure": {
        "memory_type": "character",
        "memories": [
          {
            "memory_id": "character_YYYYMMDDHHMMSS",
            "created_at": "ISO 8601 datetime",
            "updated_at": "ISO 8601 datetime",
            "data": {
              "basic_info": {
                "name": "string (required)",
                "age": "integer",
                "gender": "string",
                "occupation": "string",
                "appearance": "string",
                "background": "string"
              },
              "personality": {
                "core_traits": ["string"],
                "contradictions": [
                  {
                    "trait1": "string",
                    "trait2": "string",
                    "context": "string",
                    "resolution": "string"
                  }
                ],
                "growth_direction": "string"
              },
              "speech_style": {
                "catchphrases": ["string"],
                "word_preference": {
                  "formal_level": "string (formal|casual|mixed)",
                  "vocabulary_style": "string",
                  "preferred_words": ["string"],
                  "avoided_words": ["string"]
                },
                "sentence_patterns": ["string"],
                "emotional_expression": {
                  "expression_style": "string (直接|含蓄|反讽)",
                  "under_stress": "string",
                  "when_happy": "string",
                  "when_angry": "string"
                }
              },
              "behavior_pattern": {
                "decision_style": {
                  "style": "string (果断|谨慎|犹豫)",
                  "based_on": "string (逻辑|直觉|情感)",
                  "example": "string"
                },
                "stress_response": {
                  "typical_response": "string",
                  "physical_signs": ["string"],
                  "coping_mechanism": "string"
                },
                "social_interaction": {
                  "approachability": "string",
                  "trust_level": "string",
                  "communication_style": "string",
                  "relationship_patterns": ["string"]
                }
              },
              "emotional_traits": {
                "expression_style": {
                  "style": "string (内敛|外放|波动)",
                  "intensity": "string (强烈|温和|平淡)",
                  "visibility": "string (易察觉|不易察觉)"
                },
                "emotional_triggers": [
                  {
                    "trigger": "string",
                    "emotion": "string",
                    "response": "string"
                  }
                ]
              },
              "growth_arc": {
                "arc": {
                  "starting_point": "string",
                  "ending_point": "string",
                  "arc_type": "string (成长|堕落|平坦)"
                },
                "turning_points": [
                  {
                    "chapter": "integer",
                    "event": "string",
                    "change": "string"
                  }
                ]
              }
            },
            "metadata": {
              "importance": "string (main|important|minor)",
              "first_appearance": "integer (chapter)",
              "last_updated_chapter": "integer"
            }
          }
        ]
      }
    },
    "plot": {
      "description": "第三层：剧情逻辑层 - 追踪故事主线和支线的发展",
      "file": "plot_logic.json",
      "structure": {
        "memory_type": "plot",
        "memories": [
          {
            "memory_id": "plot_YYYYMMDDHHMMSS",
            "created_at": "ISO 8601 datetime",
            "updated_at": "ISO 8601 datetime",
            "data": {
              "plot_type": "string (main|sub)",
              "plot_name": "string",
              "description": "string",
              "start_chapter": "integer",
              "current_chapter": "integer",
              "status": "string (进行中|已完成|暂停)",
              "key_events": [
                {
                  "chapter": "integer",
                  "event": "string",
                  "characters_involved": ["string"],
                  "impact": "string"
                }
              ],
              "timeline": {
                "start_time": "string (故事内时间)",
                "current_time": "string",
                "duration": "string"
              },
              "causality": [
                {
                  "cause": "string",
                  "effect": "string",
                  "chapter": "integer"
                }
              ]
            },
            "metadata": {
              "importance": "string (critical|important|minor)",
              "dependencies": ["plot_id"]
            }
          }
        ]
      }
    },
    "context": {
      "description": "第四层：上下文关联层 - 管理章节间的关联信息",
      "file": "context_relations.json",
      "structure": {
        "memory_type": "context",
        "memories": [
          {
            "memory_id": "context_YYYYMMDDHHMMSS",
            "created_at": "ISO 8601 datetime",
            "updated_at": "ISO 8601 datetime",
            "data": {
              "chapter": "integer",
              "title": "string",
              "summary": "string",
              "key_elements": [
                {
                  "type": "string (item|location|ability)",
                  "name": "string",
                  "description": "string"
                }
              ],
              "foreshadowing": {
                "planted": [
                  {
                    "description": "string",
                    "chapter": "integer",
                    "resolved": "boolean",
                    "resolved_chapter": "integer"
                  }
                ],
                "unresolved": ["string"]
              },
              "character_states": [
                {
                  "name": "string",
                  "emotional_state": "string",
                  "location": "string",
                  "goals": ["string"]
                }
              ],
              "unresolved_questions": ["string"]
            },
            "metadata": {
              "word_count": "integer",
              "created_date": "ISO 8601 date"
            }
          }
        ]
      }
    },
    "history": {
      "description": "第五层：创作历史层 - 记录创作过程中的决策和修改",
      "file": "creation_history.json",
      "structure": {
        "memory_type": "history",
        "memories": [
          {
            "memory_id": "history_YYYYMMDDHHMMSS",
            "created_at": "ISO 8601 datetime",
            "updated_at": "ISO 8601 datetime",
            "data": {
              "chapter": "integer",
              "version": "integer",
              "title": "string",
              "content_summary": "string",
              "characters_involved": ["string"],
              "key_events": ["string"],
              "creative_decisions": [
                {
                  "decision": "string",
                  "reason": "string",
                  "alternative_considered": "string"
                }
              ],
              "modifications": [
                {
                  "date": "ISO 8601 datetime",
                  "type": "string (add|delete|modify)",
                  "description": "string",
                  "reason": "string"
                }
              ],
              "calibration_records": [
                {
                  "date": "ISO 8601 datetime",
                  "type": "string (style|character|plot)",
                  "deviation_score": "number",
                  "issues_found": ["string"],
                  "corrections_made": ["string"]
                }
              ]
            },
            "metadata": {
              "writing_time": "string (duration)",
              "revision_count": "integer"
            }
          }
        ]
      }
    }
  },
  "relationships": {
    "character_to_plot": "characters can be involved in multiple plots",
    "plot_to_context": "plots span across multiple chapters/contexts",
    "context_to_history": "each chapter has corresponding history records",
    "style_dna_to_history": "style calibration results are recorded in history"
  },
  "validation_rules": {
    "memory_id_format": "must match pattern: {type}_YYYYMMDDHHMMSS",
    "datetime_format": "must be ISO 8601 format",
    "ratio_values": "must be between 0 and 1",
    "required_fields": "all fields marked as required must be present"
  }
}
