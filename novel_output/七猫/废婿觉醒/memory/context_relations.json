      "data": {
        "chapter": 0,
        "title": "岳母的嘴脸",
        "summary": "林辰向王丽华展示银行余额99万，王丽华态度180度转变，从辱骂变为讨好。苏大强震惊嫉妒，把自己关在房间里打电话打听林辰赚钱的来路。苏清雪注意到林辰的眼神变化——从低头到敢于平视。林辰意识到在这个家里的规则从来不是对错而是价值。收到苏大强关于家族聚会的警告，林辰决定参加。张怀远邀请他第二天见面。",
        "key_elements": [],
        "foreshadowing": {
          "planted": [],
          "unresolved": []
        },
        "character_states": {
          "林辰": "从隐忍到有了底气，开始反击",
          "王丽华": "势利眼，得知有钱后态度180度转变",
          "苏大强": "嫉妒+恐惧，暗中打电话调查",
          "苏清雪": "对林辰产生好奇，注意到他的变化"
        },
        "unresolved_questions": []
      },
      "metadata": {
        "source": "sync-chapter"
      }
    },
    {
