      "data": {
        "chapter": 0,
        "title": "家族聚会",
        "summary": "苏家家族聚会，苏大强邀请所有亲戚当众质疑林辰的一百万收入。苏明远嘲笑林辰不懂古玩，苏美兰表示怀疑。林辰出示银行流水但仍被质疑造假。苏大强请来国家级鉴定师赵志强明天鉴定，如果作假要送林辰坐牢。林辰坦然接受。苏清雪对林辰的'看得到'说法产生强烈好奇，开始重新审视他。林辰私下联系张怀远请求明天出面作证。",
        "key_elements": [],
        "foreshadowing": {
          "planted": [],
          "unresolved": []
        },
        "character_states": {
          "林辰": "镇定面对质疑，不再退缩",
          "苏大强": "嫉妒+恐惧地位受威胁，誓要揭穿",
          "苏清雪": "好奇心被激发，决定亲眼见证结果",
          "苏明远": "不屑+不安，因林辰的镇定而动摇"
        },
        "unresolved_questions": []
      },
