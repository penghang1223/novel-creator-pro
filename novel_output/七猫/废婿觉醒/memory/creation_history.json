      }
    },
    {
      "memory_id": "history_20260426204308175826",
      "memory_type": "history",
      "created_at": "2026-04-26T20:43:08",
      "updated_at": "2026-04-26T20:43:08",
      "data": {
        "chapter": 0,
        "version": 1,
        "title": "家族聚会",
        "content_summary": "苏家家族聚会，苏大强邀请所有亲戚当众质疑林辰的一百万收入。苏明远嘲笑林辰不懂古玩，苏美兰表示怀疑。林辰出示银行流水但仍被质疑造假。苏大强请来国家级鉴定师赵志强明天鉴定，如果作假要送林辰坐牢。林辰坦然接受。苏清雪对林辰的'看得到'说法产生强烈好奇，开始重新审视他。林辰私下联系张怀远请求明天出面作证。",
        "characters_involved": [],
        "key_events": [
          "苏大强召集家族聚会公开质疑林辰",
          "苏明远嘲笑+苏美兰怀疑",
          "林辰出示银行流水",
          "苏大强请来赵志强专家鉴定",
          "林辰联系张怀远作证",
          "苏清雪开始重新认识林辰"
        ],
        "creative_decisions": [],
        "modifications": [],
        "calibration_records": []
      },
      "metadata": {
