      "data": {
        "chapter": 0,
        "version": 1,
        "title": "日常订单",
        "content_summary": "林小满到百味楼接苏小棠（青云宗弟子），传送150里到青云山脉，获得80灵石（960修为含好评加成），突破练气二层。苏小棠提到曾遇到散修黑司机半路跑路，对天行系统的评价机制很认可。这是王大锤口碑传播带来的第一个新用户。伏笔：青云宗情报工作做得很好，已注意到天行系统。",
        "characters_involved": [],
        "key_events": [
          "百味楼接苏小棠",
          "150里远距离传送",
          "突破练气二层",
          "苏小棠提到散修黑司机",
          "口碑传播验证"
        ],
        "creative_decisions": [],
        "modifications": [],
        "calibration_records": []
      },
      "metadata": {
        "source": "sync-chapter"
      }
